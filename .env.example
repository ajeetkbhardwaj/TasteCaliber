# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# TASTE_DB_PATH: Local SQLite storage path (defaults to ./data/taste.db)
TASTE_DB_PATH="./data/taste.db"

# Local Inference Engine (Ollama / LM Studio / vLLM / llama.cpp) - no API key needed
LOCAL_LLM_BASE_URL="http://localhost:11434/v1"
LOCAL_LLM_MODEL="qwen2.5-coder:7b"

# NVIDIA NIM Free Inference Endpoint (https://build.nvidia.com)
NVIDIA_API_KEY=""

# OpenRouter Free Models Endpoint (https://openrouter.ai)
OPENROUTER_API_KEY=""

# Optional Bearer Token for remote /mcp deployments (leave empty for open localhost dev)
TASTE_API_TOKEN=""

# Optional Gemini API Key if configured
GEMINI_API_KEY="MY_GEMINI_API_KEY"
